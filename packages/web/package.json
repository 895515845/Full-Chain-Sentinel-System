{
	"name": "@earendil-works/zgagent-web",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"description": "ZGAgent web console: HTTP + WebSocket server and browser UI for the penetration testing agent",
	"bin": {
		"zgagent-web": "dist/index.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"scripts": {
		"clean": "shx rm -rf dist webui/dist",
		"build": "tsc -p tsconfig.json && npm run build:webui",
		"build:webui": "vite build webui",
		"check:webui": "tsc -p webui/tsconfig.json --noEmit",
		"test": "vitest --run",
		"start": "node dist/index.js"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^1.1.0",
		"react-markdown": "10.1.0",
		"remark-gfm": "4.0.1",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/ws": "8.18.2",
		"@vitejs/plugin-react": "6.1.2",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"shx": "0.3.4",
		"vite": "8.3.4"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}

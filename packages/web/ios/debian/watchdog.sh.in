#!/bin/sh
PATH="/var/jb/usr/bin:/var/jb/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH
# Restart the bridge when its control loop stops updating the heartbeat file.
# launchd KeepAlive only handles exits; a suspended process keeps its socket
# open and never reconnects, so this separate job detects the stall and kicks
# the main LaunchDaemon.
LABEL="com.zgsfsec.sentinelbridged"
HEARTBEAT="@HEARTBEAT@"

LAUNCHCTL="$(command -v launchctl 2>/dev/null || true)"
if [ -z "$LAUNCHCTL" ] || [ ! -x "$LAUNCHCTL" ]; then
	LAUNCHCTL="/var/jb/usr/bin/launchctl"
fi
if [ ! -x "$LAUNCHCTL" ]; then
	LAUNCHCTL="/bin/launchctl"
fi

while true; do
	sleep 10
	now="$(date +%s 2>/dev/null || echo 0)"
	mtime=0
	if [ -f "$HEARTBEAT" ]; then
		mtime="$(date -r "$HEARTBEAT" +%s 2>/dev/null || echo 0)"
	fi
	age=$((now - mtime))
	if [ "$now" -le 0 ] || [ "$age" -gt 45 ]; then
		echo "$(date) heartbeat stale (${age}s), restarting $LABEL"
		"$LAUNCHCTL" kickstart -k "system/$LABEL" 2>/dev/null || true
		sleep 10
	fi
done

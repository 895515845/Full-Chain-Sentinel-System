#!/bin/sh
set -e

LABEL="com.zgsfsec.sentinelbridged"
PLIST="@PLIST@"
CONFIG="@CONFIG@"
EXAMPLE="@EXAMPLE@"

if [ -f "$CONFIG" ]; then
	chmod 600 "$CONFIG" 2>/dev/null || true
fi

launchctl bootout "system/$LABEL" 2>/dev/null || true
launchctl bootstrap system "$PLIST" 2>/dev/null || launchctl load -w "$PLIST" 2>/dev/null || true

if [ -f "$CONFIG" ]; then
	echo "SentinelBridge 已加载；日志：/var/log/sentinelbridge.log"
else
	echo "SentinelBridge 已安装，等待配对。"
	echo "  在设备 Safari 打开：http://127.0.0.1:9945/setup"
	echo "  配对码由控制台「iOS 设备」页生成，10 分钟内有效。"
	echo "  日志：/var/log/sentinelbridge.log"
fi
exit 0
